# Postgres — docker compose maps 5432 to the host so `make dev` and `make up` share one DB.
DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"

# Where the build worker writes immutable artifacts. Shared volume between app + worker.
ARTIFACTS_DIR="./artifacts"

# Public origin of the runtime API. Baked into static artifacts so an exported
# zip on any static host still knows where to send cart calls. (D8)
NEXT_PUBLIC_RUNTIME_API="http://localhost:3000"

# Worker polling interval (ms). Deliberately visible so the async gap is demonstrable.
WORKER_POLL_MS=250

# Set to a page path (e.g. "/about") to make the worker throw while rendering it.
# Used by the crash-safety test: build fails, old artifact keeps serving.
BUILD_FAIL_ON_PATH=""

# Extra delay per page render (ms) so a human can watch a build be "building".
BUILD_SLOWDOWN_MS=0
