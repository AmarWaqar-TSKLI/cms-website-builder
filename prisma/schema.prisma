// CMS Website Builder — schema
//
// The tier split is load-bearing, not cosmetic:
//   Tier 1 (engine)   — versioned. Pages, revisions, themes, releases. Rolls back.
//   Tier 2 (modules)  — live. Products, orders, customers. NEVER versioned.
//
// Exactly one column crosses the boundary: sites.live_release_id.
// That column is the rollback switch and the entire coupling between the two worlds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. Against a pooled provider (e.g. Supabase's transaction
  // pooler) this is the pgbouncer endpoint; locally it's the plain database.
  url      = env("DATABASE_URL")
  // Migrations need a real session (a transaction pooler can't run them), so
  // they use a direct connection. Locally this is the same URL as above; on a
  // pooled host it's the session-mode endpoint. See DEPLOY.md.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIER 1 — ENGINE (versioned)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  sites       Site[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  /// scrypt, as "scrypt$N$r$p$salt$hash". The parameters travel with the hash so
  /// they can be raised later without invalidating everyone's password.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships Membership[]
  sessions    Session[]
  activity    ActivityLog[]
  locks       PageLock[]

  @@map("users")
}

/// A logged-in browser.
///
/// The row stores a SHA-256 of the token, never the token itself. Someone who
/// reads this table therefore cannot sign in as anybody — the same reason the
/// password column holds a hash. The plaintext exists only in the user's cookie.
model Session {
  /// SHA-256 of the token in the cookie. The primary key IS the lookup.
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// WHO DID WHAT, WHEN.
///
/// Append-only, guarded by the same trigger as the revision tables — an audit
/// log that can be edited is not an audit log. Nothing here is ever used to
/// render a site; it exists to answer "who changed this, and when".
///
/// Deliberately denormalised: `actorName` and `summary` are written at the time
/// of the event and never re-derived. Renaming a user later must not rewrite
/// history, and a deleted page must still be explicable.
model ActivityLog {
  id         String   @id @default(uuid())
  siteId     String?  @map("site_id")
  userId     String?  @map("user_id")
  actorName  String   @map("actor_name")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_log")
}

/// PESSIMISTIC LOCK on editing a page.
///
/// One row per page while somebody has it open. Whoever arrives first edits;
/// everyone else gets a read-only view that keeps itself up to date.
///
/// The heartbeat is what makes this safe. A lock with no heartbeat for a couple
/// of minutes is dead — a closed laptop must not lock a page forever — so the
/// row is a claim that has to be continuously renewed rather than a flag someone
/// remembered to clear.
model PageLock {
  pageId      String   @id @map("page_id")
  userId      String   @map("user_id")
  acquiredAt  DateTime @default(now()) @map("acquired_at")
  heartbeatAt DateTime @default(now()) @map("heartbeat_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([heartbeatAt])
  @@map("page_locks")
}

model Membership {
  orgId  String @map("org_id")
  userId String @map("user_id")
  role   String @default("owner")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("memberships")
}

model Site {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  name         String
  slug         String   @unique
  customDomain String?  @unique @map("custom_domain")
  createdAt    DateTime @default(now()) @map("created_at")

  // Set on a branch — the site it was forked from. A branch is an ordinary site
  // you edit freely; its lineage is what lets us diff it against its parent
  // block-by-block and merge the changes back. Null for a normal (trunk) site.
  parentSiteId String? @map("parent_site_id")

  // Archive, not erase: revisions and the activity log are append-only (a DB
  // trigger forbids DELETE), which is the whole point of the immutable model. So
  // "delete a site" sets this; it drops out of every list and stops serving, and
  // its slug/domain are freed for reuse. Nothing that was published is destroyed.
  deletedAt DateTime? @map("deleted_at")

  // ── THE ROLLBACK SWITCH ──────────────────────────────────────────────────
  // The only column connecting versioned content to what visitors actually see.
  // Rollback is: UPDATE sites SET live_release_id = <older release>. That's all.
  liveReleaseId String? @map("live_release_id")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  liveRelease Release?     @relation("LiveRelease", fields: [liveReleaseId], references: [id])

  modules   SiteModule[]
  pages     Page[]
  components Component[]
  themes    Theme[]
  releases  Release[]    @relation("SiteReleases")
  media     Media[]
  products  Product[]
  collections Collection[]
  customers Customer[]
  orders    Order[]
  posts     Post[]
  tags      Tag[]
  activity  ActivityLog[]
  formSubmissions FormSubmission[]
  apiKeys   ApiKey[]
  baseline  BranchBaseline?

  @@map("sites")
}

/// THE FORK POINT — what the parent looked like the moment a branch was created.
///
/// Written once at fork, read by diff and merge, gone with the branch (cascade).
/// This is what upgrades the branch diff from two-way to three-way: with a base,
/// "changed" can distinguish "the branch edited this" from "the PARENT moved on
/// since the fork" — the first merges cleanly, the second must not be silently
/// reverted, and both-changed is a conflict a person has to resolve.
model BranchBaseline {
  branchSiteId String   @id @map("branch_site_id")
  /// Flat map nodeId → {type, text:{field:value}} across the parent's components
  /// at fork time. Every node, even textless ones — structure needs them.
  blocks       Json
  /// Theme tokens at fork time, for three-way theme comparison.
  tokens       Json
  /// parent component id → branch component id, recorded from the fork's copy
  /// step. What lets merge translate page references between the two sites.
  componentMap Json     @map("component_map")
  /// The parent's page paths at fork time — so a page the PARENT added after the
  /// fork is never mistaken for one the branch deleted.
  pagePaths    Json     @map("page_paths")
  createdAt    DateTime @default(now()) @map("created_at")

  branchSite Site @relation(fields: [branchSiteId], references: [id], onDelete: Cascade)

  @@map("branch_baselines")
}

/// A read-only key for the headless Content API.
///
/// Same discipline as Session and the password column: the row stores only a
/// SHA-256 of the secret, never the secret itself. The plaintext is shown to the
/// owner exactly once, at creation, and cannot be recovered afterwards — a
/// leaked database therefore hands out no working keys. Revoking is a soft flag
/// (append-only spirit) so an audit of "what could read this site, and when"
/// stays answerable.
model ApiKey {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  name       String    @default("API key")
  /// SHA-256 of the token. The primary lookup — an incoming key is hashed and
  /// matched here, so the plaintext never has to exist server-side.
  keyHash    String    @unique @map("key_hash")
  /// A short, non-secret prefix ("cms_live_a1b2…") shown in the dashboard so the
  /// owner can tell their keys apart without ever seeing the full secret again.
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  createdBy  String?   @map("created_by")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("api_keys")
}

enum ModuleName {
  blog
  commerce
  forms
}

/// Which Tier-2 modules a site has opted into. Drives palette filtering:
/// engine + blog ≈ WordPress, engine + commerce ≈ Shopify.
model SiteModule {
  siteId    String     @map("site_id")
  module    ModuleName
  enabledAt DateTime   @default(now()) @map("enabled_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, module])
  @@map("site_modules")
}

/// Identity only — a page has NO content column. Content lives in drafts
/// (mutable, one row) and revisions (immutable, many rows).
model Page {
  id        String    @id @default(uuid())
  siteId    String    @map("site_id")
  path      String
  type      String    @default("page")
  title     String    @default("Untitled")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  draft     PageDraft?
  revisions PageRevision[]
  lock      PageLock?

  // The real constraint is a PARTIAL unique index — UNIQUE(site_id, path)
  // WHERE deleted_at IS NULL — added by raw SQL in the migration, because a
  // soft-deleted page must not block reusing its path.
  @@index([siteId])
  @@map("pages")
}

/// OVERWRITE-ONLY. page_id is the primary key, so one draft per page is a
/// database guarantee, not a convention.
///
/// What this row holds is now ONLY THE ARRANGEMENT: an ordered list of
/// references to components, plus each reference's per-page overrides. None of
/// the content. Reordering blocks writes here; editing a block's text does not.
model PageDraft {
  pageId      String   @id @map("page_id")
  body        Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  /// Optimistic lock. A stale write gets 409 → "edited in another tab".
  lockVersion Int      @default(0) @map("lock_version")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_drafts")
}

/// APPEND-ONLY. Never updated, never deleted. One row per publish per page,
/// holding the WHOLE tree — the arrangement is the information worth keeping.
model PageRevision {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  body      Json
  versionNo Int      @map("version_no")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, versionNo])
  @@index([pageId])
  @@map("page_revisions")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPONENTS — the unit of storage.
//
// A page does not contain its blocks. It contains an ORDERED LIST OF REFERENCES
// to component records, and each component holds its own tree. Drop a Hero onto
// a page and a component row is created; the page gains one reference to it.
//
// This is what collapses two ideas into one. There is no separate notion of a
// "shared" component: a component referenced by one page is an ordinary block,
// and the same component referenced by five pages is a shared header. Nothing
// about the record differs — only how many pages point at it. Editing one
// therefore changes exactly the pages that reference it, which by default is one.
//
// THE UNIT IS A COMPONENT, NOT A NODE. A component's body is still a whole tree:
// a Columns component holds its Cards and their Buttons inline. Going one level
// finer — a row per node, with parent_id and sort_order — would make reordering a
// multi-row transaction and "what did this page look like on Tuesday?" a
// recursive query over independently-versioned rows. `make verify` check 4
// enforces that line.
//
// The trio below is a deliberate copy of Page / PageDraft / PageRevision — same
// identity-only parent, same overwrite-only draft keyed by its parent id, same
// append-only revision table under the same trigger. One versioning story,
// applied to both things that have versions.
// ─────────────────────────────────────────────────────────────────────────────

/// Identity only, exactly like Page. No content column.
model Component {
  id        String    @id @default(uuid())
  siteId    String    @map("site_id")
  /// Set only when someone names it, which is what puts it in the palette for
  /// reuse. An ordinary block dropped on a page has no name and never needs one.
  name      String?
  /// The root block type ("Hero", "Columns"), so lists can be labelled without
  /// parsing the body. Denormalised on purpose; it is display, not truth.
  kind      String    @default("Section")
  icon      String    @default("◈")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  site      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  draft     ComponentDraft?
  revisions ComponentRevision[]

  // Partial unique index UNIQUE(site_id, name) WHERE deleted_at IS NULL AND name
  // IS NOT NULL lives in raw SQL — unnamed components must not collide with each
  // other, and a deleted one must not keep reserving its name.
  @@index([siteId])
  @@map("components")
}

/// OVERWRITE-ONLY, one row per component — component_id IS the primary key.
///
/// Note what this buys now that every block is a component: the lock is per
/// component, so two people editing different sections of the same page do not
/// collide. Only reordering touches the page's own row.
model ComponentDraft {
  componentId String   @id @map("component_id")
  body        Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  lockVersion Int      @default(0) @map("lock_version")

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@map("component_drafts")
}

/// APPEND-ONLY. Guarded by the same cms_forbid_mutation() trigger as
/// page_revisions. This is what makes "roll back and the old version returns"
/// true: the release pinned a revision id, and that row can never change.
model ComponentRevision {
  id          String   @id @default(uuid())
  componentId String   @map("component_id")
  body        Json
  versionNo   Int      @map("version_no")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, versionNo])
  @@index([componentId])
  @@map("component_revisions")
}

model Theme {
  id                String  @id @default(uuid())
  siteId            String  @map("site_id")
  name              String
  currentRevisionId String? @map("current_revision_id")

  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  revisions ThemeRevision[]

  @@map("themes")
}

model ThemeRevision {
  id        String   @id @default(uuid())
  themeId   String   @map("theme_id")
  tokens    Json
  layout    Json
  versionNo Int      @map("version_no")
  createdAt DateTime @default(now()) @map("created_at")

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, versionNo])
  @@map("theme_revisions")
}

enum ReleaseStatus {
  building
  ready
  failed
}

enum ArtifactType {
  static
  container
}

/// A release is a site-wide snapshot. Publish is site-wide, not per-page —
/// a page that links to a page that no longer exists is not a "version".
model Release {
  id           String        @id @default(uuid())
  siteId       String        @map("site_id")
  versionNo    Int           @map("version_no")
  status       ReleaseStatus @default(building)
  artifactType ArtifactType  @default(static) @map("artifact_type")
  artifactUrl  String?       @map("artifact_url")
  buildError   String?       @map("build_error")
  notes        String?
  createdBy    String?       @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  site         Site                  @relation("SiteReleases", fields: [siteId], references: [id], onDelete: Cascade)
  liveForSites Site[]                @relation("LiveRelease")
  items        ReleaseItem[]
  dependencies ReleaseDependency[]
  buildJobs    BuildJob[]
  frozenData   ReleaseData?

  @@unique([siteId, versionNo])
  @@index([siteId, createdAt])
  @@map("releases")
}

enum EntityType {
  page
  theme
  component
}

/// THE MANIFEST. Pins exactly which revision of which entity belongs to this
/// release. Building a release is a pure function of these rows — which is why
/// an old release never needs rebuilding.
model ReleaseItem {
  releaseId  String     @map("release_id")
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")
  /// Polymorphic: points at page_revisions when entity_type='page', at
  /// theme_revisions when entity_type='theme', and at shared_component_revisions
  /// when entity_type='component'. Deliberately carries no foreign key — a single
  /// column cannot reference three tables. Integrity is instead guaranteed by the
  /// append-only trigger: no target can ever be deleted.
  ///
  /// Adding shared components to the manifest cost exactly one enum value. That
  /// is the whole reason this column was left polymorphic.
  revisionId String     @map("revision_id")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@id([releaseId, entityType, entityId])
  @@map("release_items")
}

/// THE FROZEN SIDE OF TIER 2.
///
/// Written once, by the build job, before a release ever goes live. Holds the
/// resolved products, collections and media a release's pages reference — titles
/// and prices as they were at publish time.
///
/// This exists so that rendering a release is a pure function of immutable rows.
/// Without it, a page served from the runtime would show today's prices while
/// the same page served from an export showed the publish-time ones, and "this
/// release renders the same thing every time" would stop being true. It is the
/// database equivalent of what the old static artifact froze into its HTML.
///
/// Append-only, same trigger as the revision tables.
model ReleaseData {
  releaseId String   @id @map("release_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@map("release_data")
}

enum RefType {
  product
  collection
  post
  media
  /// A page depending on a shared component. Unlike the others this points at
  /// versioned (Tier-1) data, which is why it is also pinned in release_items.
  /// Recording it here too is what answers "which live releases use this header?"
  /// before someone deletes it — the same question, the same reverse index.
  component
}

/// The reverse index that makes D5's accepted cost VISIBLE rather than fatal.
/// Extracted at publish time by walking each body against the component prop
/// schemas. Answers: "what breaks if I delete this product?"
model ReleaseDependency {
  releaseId String  @map("release_id")
  refType   RefType @map("ref_type")
  refId     String  @map("ref_id")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@id([releaseId, refType, refId])
  @@index([refType, refId])
  @@map("release_dependencies")
}

model Media {
  id         String    @id @default(uuid())
  siteId     String    @map("site_id")
  // storageKey holds the image itself as a data: URI, not a path to object
  // storage. That is the load-bearing choice from decision I13: a data URI is
  // what lets an exported artifact opened from file:// render with no network.
  // Uploads (added later) downscale in the browser and store the result here, so
  // the property survives even though images are now real rather than seeded.
  storageKey String    @map("storage_key")
  mime       String
  // The original file name, kept for a readable label in the library and picker.
  filename   String?
  // Alt text for accessibility. Nullable because seeded and older rows predate it.
  alt        String?
  width      Int?
  height     Int?
  sizeBytes  Int?      @map("size_bytes")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("media")
}

enum BuildJobStatus {
  queued
  running
  done
  failed
}

/// The queue. DB-as-queue, claimed with SKIP LOCKED so multiple workers are safe.
/// A separate OS process polls this table — kill it mid-build and nothing breaks.
model BuildJob {
  id         String         @id @default(uuid())
  releaseId  String         @map("release_id")
  status     BuildJobStatus @default(queued)
  attempts   Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  startedAt  DateTime?      @map("started_at")
  finishedAt DateTime?      @map("finished_at")
  error      String?

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("build_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIER 2 — COMMERCE (live, never versioned)
//
// No revision tables here on purpose. Rolling back a homepage design must not
// un-place an order or resurrect a deleted product. Deletes are SOFT so a frozen
// artifact referencing gone data degrades gracefully instead of 500-ing.
// ─────────────────────────────────────────────────────────────────────────────

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id          String        @id @default(uuid())
  siteId      String        @map("site_id")
  title       String
  description String        @default("")
  imageUrl    String?       @map("image_url")
  status      ProductStatus @default(active)
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  collections CollectionProduct[]

  @@index([siteId])
  @@map("products")
}

model ProductVariant {
  id           String @id @default(uuid())
  productId    String @map("product_id")
  sku          String
  priceCents   Int    @map("price_cents")
  inventoryQty Int    @default(0) @map("inventory_qty")
  options      Json   @default("{}")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  lineItems OrderLineItem[]

  @@index([productId])
  @@map("product_variants")
}

model Collection {
  id        String    @id @default(uuid())
  siteId    String    @map("site_id")
  title     String
  handle    String
  rules     Json      @default("{}")
  deletedAt DateTime? @map("deleted_at")

  site     Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  products CollectionProduct[]

  @@unique([siteId, handle])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

model Customer {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  email     String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([siteId, email])
  @@map("customers")
}

enum OrderStatus {
  pending
  paid
  fulfilled
  cancelled
}

model Order {
  id         String      @id @default(uuid())
  siteId     String      @map("site_id")
  customerId String?     @map("customer_id")
  status     OrderStatus @default(paid)
  totalCents Int         @map("total_cents")
  placedAt   DateTime    @default(now()) @map("placed_at")

  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer  Customer?       @relation(fields: [customerId], references: [id])
  lineItems OrderLineItem[]

  @@index([siteId, placedAt])
  @@map("orders")
}

model OrderLineItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  variantId String @map("variant_id")
  qty       Int
  /// SNAPSHOT. Never join to product_variants for a historical price — the
  /// variant's price today has nothing to do with what this customer paid.
  priceAtPurchaseCents Int @map("price_at_purchase_cents")
  titleAtPurchase      String @default("") @map("title_at_purchase")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_line_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIER 2 — BLOG (live; bodies versioned, but posts are NOT pinned by releases)
// ─────────────────────────────────────────────────────────────────────────────

enum PostStatus {
  draft
  published
}

model Post {
  id                String     @id @default(uuid())
  siteId            String     @map("site_id")
  title             String
  slug              String
  excerpt           String     @default("")
  authorId          String?    @map("author_id")
  status            PostStatus @default(draft)
  currentRevisionId String?    @map("current_revision_id")
  publishedAt       DateTime?  @map("published_at")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  revisions PostRevision[]
  tags      PostTag[]

  @@unique([siteId, slug])
  @@map("posts")
}

model PostRevision {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  body      Json
  versionNo Int      @map("version_no")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, versionNo])
  @@map("post_revisions")
}

model Tag {
  id     String @id @default(uuid())
  siteId String @map("site_id")
  name   String
  slug   String

  site  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts PostTag[]

  @@unique([siteId, slug])
  @@map("tags")
}

model PostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIER 2 — FORMS (live; submissions are NEVER versioned)
//
// A visitor filling in a contact or newsletter form writes one row here. Like an
// order, a submission is live business reality: rolling back a page's DESIGN must
// never un-submit somebody's message. So there is no revision table and no
// release ever pins a submission — exactly why orders and posts sit on this side
// of the line too (D5). The form BLOCK that produced it is versioned Tier-1
// content; what a visitor typed into it is not.
// ─────────────────────────────────────────────────────────────────────────────

model FormSubmission {
  id      String @id @default(uuid())
  siteId  String @map("site_id")
  /// Which form block this came from — the block's stable key, so one site can
  /// have several forms and each keeps its own inbox.
  formKey String @map("form_key")
  /// A human label, copied in at submit time so the inbox still reads well after
  /// the block is renamed or removed. Same denormalisation as the audit log's
  /// actor name, and for the same reason.
  formName String @default("") @map("form_name")
  /// The submitted fields as { name: value }. JSON because a form's shape is the
  /// author's to decide, not the schema's.
  data Json
  /// Lifted out of `data` when present, for a readable inbox and a reply link.
  email String?
  /// Set when someone opens it in the dashboard. Not a workflow — just "seen".
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("form_submissions")
}
