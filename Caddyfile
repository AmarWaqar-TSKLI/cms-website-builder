# Production reverse proxy with automatic HTTPS (Let's Encrypt).
# Replace your-domain.com with your real domain, then:
#   docker compose -f compose.prod.yml up -d --build
#
# Caddy fetches and renews certificates on its own; there is nothing else to run.

# On-demand TLS: before issuing a certificate for a customer's domain, Caddy asks
# the app whether some site has actually connected it. Without this gate, anyone
# pointing a hostname at our IP could make us request unlimited certificates.
{
	on_demand_tls {
		ask http://app:3000/api/domains/check
	}
}

# The builder's own domain — a normal, always-valid certificate.
your-domain.com {
	reverse_proxy app:3000
}

# ── Custom domains for the sites people build ─────────────────────────────────
# Any domain a customer points at this box is served by the same app (it matches
# the Host header against sites.custom_domain — release.ts / I9). It gets HTTPS
# automatically, but ONLY if /api/domains/check confirms a site claims it.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}
